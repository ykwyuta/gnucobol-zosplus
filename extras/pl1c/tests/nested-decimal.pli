BANK: PROCEDURE OPTIONS(MAIN);
  DCL
    1 ACCOUNT,
      5 ACCT_NAME CHAR(6) INIT('ABC'),
      5 BALANCE FIXED DEC(6,2) INIT(12.30);
  CALL SHOW_BALANCE;
  RETURN;

SHOW_BALANCE: PROCEDURE;
  DCL REPORT CHAR(20);
  REPORT = TRIM(ACCT_NAME) || ':' || TRIM(CHAR(BALANCE));
  PUT SKIP LIST(TRIM(REPORT));
  RETURN;
END SHOW_BALANCE;

END BANK;
