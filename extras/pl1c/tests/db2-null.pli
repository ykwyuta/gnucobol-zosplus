NULLTEST: PROCEDURE OPTIONS(MAIN);
  EXEC SQL INCLUDE SQLCA;
  DCL VALUE FIXED BIN(31) INIT(9);
  DCL IND FIXED BIN(15) INIT(0);
  EXEC SQL SELECT CAST(NULL AS INTEGER) INTO :VALUE :IND
    FROM SYSIBM.SYSDUMMY1;
  IF SQLCODE = 0 THEN PUT SKIP LIST(IND, VALUE);
  EXEC SQL SELECT CAST(NULL AS INTEGER) INTO :VALUE
    FROM SYSIBM.SYSDUMMY1;
  PUT SKIP LIST(SQLCODE, SQLSTATE);
END NULLTEST;
