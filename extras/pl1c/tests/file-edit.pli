FILEEDIT: PROCEDURE OPTIONS(MAIN);
  DCL CARD FILE RECORD INPUT ENV(F RECSIZE(80));
  DCL CARD_TEXT CHAR(80);
  DCL CODE CHAR(6);
  DCL OUTPUT_LINE CHAR(20);
  DCL COUNT FIXED BIN(15) INIT(7);
  DCL AMOUNT FIXED DEC(12,2) INIT(12.30);
  ON ENDFILE(CARD)
    BEGIN;
      PUT SKIP LIST('NO CARD');
      GO TO DONE;
    END;
  OPEN FILE(CARD);
  READ FILE(CARD) INTO(CARD_TEXT);
  CLOSE FILE(CARD);
  CODE = SUBSTR(CARD_TEXT, 1, 6);
  PUT STRING(OUTPUT_LINE) EDIT('CODE=', CODE, COUNT) (A, A, F(5));
  PUT SKIP EDIT(OUTPUT_LINE) (A);
  PUT STRING(OUTPUT_LINE) EDIT(AMOUNT) (F(10,2));
  PUT SKIP EDIT(OUTPUT_LINE) (A);
DONE:
  RETURN;
END FILEEDIT;
