CURTEST: PROCEDURE OPTIONS(MAIN);
  EXEC SQL INCLUDE SQLCA;
  DCL ANSWER FIXED BIN(31);
  DCL FLAG CHAR(1) INIT('Y');
  EXEC SQL DECLARE ONE_ROW CURSOR FOR
    SELECT 7 FROM SYSIBM.SYSDUMMY1 WHERE IBMREQD = :FLAG;
  EXEC SQL OPEN ONE_ROW;
  IF SQLCODE ^= 0 THEN RETURN;
  EXEC SQL FETCH ONE_ROW INTO :ANSWER;
  IF SQLCODE = 0 THEN PUT SKIP LIST(ANSWER);
  EXEC SQL FETCH ONE_ROW INTO :ANSWER;
  IF SQLCODE = 100 THEN PUT SKIP LIST('EOF', SQLSTATE);
  EXEC SQL CLOSE ONE_ROW;
END CURTEST;
