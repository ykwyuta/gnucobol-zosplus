DB2TEST: PROCEDURE OPTIONS(MAIN);
  EXEC SQL INCLUDE SQLCA;
  DCL ANSWER FIXED BIN(31);
  DCL FLAG CHAR(1) INIT('Y');
  EXEC SQL SELECT 42 INTO :ANSWER
    FROM SYSIBM.SYSDUMMY1 WHERE IBMREQD = :FLAG;
  IF SQLCODE = 0 THEN PUT SKIP LIST(ANSWER);
  ELSE PUT SKIP LIST('SQLCODE', SQLCODE, SQLSTATE);
END DB2TEST;
