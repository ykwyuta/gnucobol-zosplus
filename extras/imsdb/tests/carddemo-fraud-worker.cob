       IDENTIFICATION DIVISION.
       PROGRAM-ID. FRAUDTEST.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-AID PIC X.
       01 WS-CALEN PIC S9(4) COMP.
       01 WS-TRANSID PIC X(4).
       01 WS-LENGTH PIC S9(4) COMP.
       01 WS-CAPACITY PIC S9(4) COMP.
       01 WS-KEY PIC X(16).
       01 WS-COMMAREA.
          02 WS-ACCT-ID PIC 9(11).
          02 WS-CUST-ID PIC 9(9).
          02 WS-FRAUD-AUTH-RECORD.
             COPY CIPAUDTY.
          02 WS-FRAUD-STATUS-RECORD.
             05 WS-FRD-ACTION PIC X.
             05 WS-FRD-UPDATE-STATUS PIC X.
             05 WS-FRD-ACT-MSG PIC X(50).
       PROCEDURE DIVISION.
           CALL STATIC "COBCICS_START"
             USING WS-AID WS-CALEN WS-TRANSID
           IF WS-CALEN NOT = 16
               MOVE 12 TO RETURN-CODE
               GOBACK
           END-IF
           MOVE 16 TO WS-CAPACITY
           CALL STATIC "COBCICS_GET_COMMAREA"
             USING WS-KEY WS-CAPACITY
           INITIALIZE WS-COMMAREA
           MOVE 1 TO WS-ACCT-ID WS-CUST-ID
           MOVE 876543999 TO PA-AUTH-TIME-9C
           MOVE "261012" TO PA-AUTH-ORIG-DATE
           MOVE WS-KEY TO PA-CARD-NUM
           IF WS-AID = X'F3'
               MOVE "R" TO WS-FRD-ACTION
           ELSE
               MOVE "F" TO WS-FRD-ACTION
           END-IF
           MOVE LENGTH OF WS-COMMAREA TO WS-LENGTH WS-CAPACITY
           CALL STATIC "COBCICS_LINK_ENTER"
             USING WS-LENGTH WS-CAPACITY
           CALL STATIC "COPAUS2C" USING WS-COMMAREA
           CALL STATIC "COBCICS_LINK_EXIT"
           IF WS-FRD-UPDATE-STATUS NOT = "S"
               DISPLAY WS-FRD-ACT-MSG UPON STDERR
               MOVE 12 TO RETURN-CODE
               GOBACK
           END-IF
           CALL STATIC "COBCICS_FINISH"
           GOBACK.
