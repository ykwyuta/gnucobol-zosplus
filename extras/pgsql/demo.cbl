       IDENTIFICATION DIVISION.
       PROGRAM-ID. PGSQLDEMO.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 HV-ID PIC X(8) VALUE 'P0000001'.
       01 HV-AMOUNT PIC S9(9) COMP VALUE 42.
       01 HV-FOUND PIC S9(9) COMP VALUE 0.
       01 HV-NOTE PIC X(64) VALUE SPACES.
       01 HV-IND PIC S9(4) COMP VALUE 0.
       01 HV-DEC PIC S9(10)V99 COMP-3 VALUE 123.45.
       01 HV-DEC-OUT PIC S9(10)V99 COMP-3 VALUE 0.
       01 HV-VARYING.
          49 HV-VARYING-LEN PIC S9(4) COMP VALUE 5.
          49 HV-VARYING-TEXT PIC X(16) VALUE 'HELLO'.
       01 HV-VARYING-OUT.
          49 HV-VARYING-OUT-LEN PIC S9(4) COMP VALUE 0.
          49 HV-VARYING-OUT-TEXT PIC X(16) VALUE SPACES.
           EXEC SQL INCLUDE SQLCA END-EXEC.
           EXEC SQL DECLARE PGCUR CURSOR FOR
             SELECT AMOUNT FROM PGSQL_DEMO
             WHERE ID >= 'P0000001' AND ID <= 'P0000002'
             ORDER BY ID
           END-EXEC.
       PROCEDURE DIVISION.
           EXEC SQL DELETE FROM PGSQL_DEMO
             WHERE ID IN ('P0000001', 'P0000002') END-EXEC.
           EXEC SQL INSERT INTO PGSQL_DEMO (ID, AMOUNT, NOTE)
             VALUES (:HV-ID, :HV-AMOUNT, 'it''s ?') END-EXEC.
           PERFORM CHECK-OK.
           EXEC SQL SELECT AMOUNT, NOTE
             INTO :HV-FOUND, :HV-NOTE FROM PGSQL_DEMO
             WHERE ID = :HV-ID END-EXEC.
           PERFORM CHECK-OK.
           IF HV-FOUND NOT = 42 OR HV-NOTE(1:6) NOT = "it's ?"
               PERFORM FAILED
           END-IF.
           EXEC SQL SELECT CAST(:HV-DEC AS NUMERIC(12,2))
             INTO :HV-DEC-OUT FROM PGSQL_DEMO
             WHERE ID = :HV-ID END-EXEC.
           PERFORM CHECK-OK.
           IF HV-DEC-OUT NOT = 123.45 PERFORM FAILED END-IF.
           EXEC SQL SELECT CAST(:HV-VARYING AS VARCHAR(16))
             INTO :HV-VARYING-OUT FROM PGSQL_DEMO
             WHERE ID = :HV-ID END-EXEC.
           PERFORM CHECK-OK.
           IF HV-VARYING-OUT-LEN NOT = 5 OR
              HV-VARYING-OUT-TEXT(1:5) NOT = 'HELLO'
               PERFORM FAILED
           END-IF.
           MOVE 'P0000002' TO HV-ID.
           MOVE 20 TO HV-AMOUNT.
           EXEC SQL INSERT INTO PGSQL_DEMO (ID, AMOUNT, NOTE)
             VALUES (:HV-ID, :HV-AMOUNT, 'second') END-EXEC.
           PERFORM CHECK-OK.
           MOVE 21 TO HV-AMOUNT.
           EXEC SQL UPDATE PGSQL_DEMO SET AMOUNT = :HV-AMOUNT
             WHERE ID = :HV-ID END-EXEC.
           PERFORM CHECK-OK.
           EXEC SQL OPEN PGCUR END-EXEC.
           PERFORM CHECK-OK.
           EXEC SQL FETCH PGCUR INTO :HV-FOUND END-EXEC.
           PERFORM CHECK-OK.
           IF HV-FOUND NOT = 42 PERFORM FAILED END-IF.
           EXEC SQL FETCH PGCUR INTO :HV-FOUND END-EXEC.
           PERFORM CHECK-OK.
           IF HV-FOUND NOT = 21 PERFORM FAILED END-IF.
           EXEC SQL FETCH PGCUR INTO :HV-FOUND END-EXEC.
           IF SQLCODE NOT = 100 OR SQLSTATE NOT = '02000'
               PERFORM FAILED
           END-IF.
           EXEC SQL CLOSE PGCUR END-EXEC.
           PERFORM CHECK-OK.
           EXEC SQL COMMIT WORK END-EXEC.
           PERFORM CHECK-OK.
           MOVE 99 TO HV-AMOUNT.
           EXEC SQL UPDATE PGSQL_DEMO SET AMOUNT = :HV-AMOUNT
             WHERE ID = :HV-ID END-EXEC.
           PERFORM CHECK-OK.
           EXEC SQL ROLLBACK WORK END-EXEC.
           PERFORM CHECK-OK.
           EXEC SQL SELECT AMOUNT INTO :HV-FOUND
             FROM PGSQL_DEMO WHERE ID = :HV-ID END-EXEC.
           PERFORM CHECK-OK.
           IF HV-FOUND NOT = 21 PERFORM FAILED END-IF.
           MOVE -1 TO HV-IND.
           EXEC SQL UPDATE PGSQL_DEMO SET NOTE = :HV-NOTE :HV-IND
             WHERE ID = :HV-ID END-EXEC.
           PERFORM CHECK-OK.
           EXEC SQL SELECT NOTE INTO :HV-NOTE :HV-IND
             FROM PGSQL_DEMO WHERE ID = :HV-ID END-EXEC.
           PERFORM CHECK-OK.
           IF HV-IND NOT = -1 PERFORM FAILED END-IF.
           EXEC SQL SELECT NOTE INTO :HV-NOTE
             FROM PGSQL_DEMO WHERE ID = :HV-ID END-EXEC.
           IF SQLCODE NOT = -305 OR SQLSTATE NOT = '22002'
               PERFORM FAILED
           END-IF.
           EXEC SQL COMMIT WORK END-EXEC.
           PERFORM CHECK-OK.
           MOVE 'MISSING' TO HV-ID.
           EXEC SQL SELECT AMOUNT INTO :HV-FOUND
             FROM PGSQL_DEMO WHERE ID = :HV-ID END-EXEC.
           IF SQLCODE NOT = 100 OR SQLSTATE NOT = '02000'
               PERFORM FAILED
           END-IF.
           EXEC SQL DELETE FROM PGSQL_DEMO
             WHERE ID = :HV-ID END-EXEC.
           IF SQLCODE NOT = 100 OR SQLSTATE NOT = '02000'
               PERFORM FAILED
           END-IF.
           EXEC SQL SELECT AMOUNT INTO :HV-FOUND
             FROM PGSQL_DEMO END-EXEC.
           IF SQLCODE NOT = -811 OR SQLSTATE NOT = '21000'
               PERFORM FAILED
           END-IF.
           MOVE 'P0000001' TO HV-ID.
           MOVE 42 TO HV-AMOUNT.
           EXEC SQL INSERT INTO PGSQL_DEMO (ID, AMOUNT)
             VALUES (:HV-ID, :HV-AMOUNT) END-EXEC.
           IF SQLCODE NOT = -803 OR SQLSTATE NOT = '23505'
               PERFORM FAILED
           END-IF.
           EXEC SQL ROLLBACK WORK END-EXEC.
           PERFORM CHECK-OK.
           DISPLAY 'POSTGRES SQL OK'.
           MOVE 0 TO RETURN-CODE.
           STOP RUN.
       CHECK-OK.
           IF SQLCODE NOT = 0 PERFORM FAILED END-IF.
       FAILED.
           DISPLAY 'POSTGRES SQL FAILED ' SQLCODE ' ' SQLSTATE.
           MOVE 1 TO RETURN-CODE.
           STOP RUN.
