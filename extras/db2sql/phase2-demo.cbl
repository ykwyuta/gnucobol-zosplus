       IDENTIFICATION DIVISION.
       PROGRAM-ID. DB2PHASE2.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 HV-ID PIC X(8) VALUE 'T0000001'.
       01 HV-ID-IND PIC S9(4) COMP VALUE 0.
       01 HV-AMOUNT PIC S9(9) COMP VALUE 10.
       01 HV-FOUND PIC S9(9) COMP VALUE 0.
       01 HV-DEC PIC S9(10)V99 COMP-3 VALUE 123.45.
       01 HV-DEC-FOUND PIC S9(10)V99 COMP-3 VALUE 0.
       01 HV-NULL-IND PIC S9(4) COMP VALUE 0.
       01 HV-TEST PIC S9(9) COMP VALUE 0.
           EXEC SQL INCLUDE SQLCA END-EXEC.
           EXEC SQL INCLUDE DB2DEMO END-EXEC.
           EXEC SQL DECLARE DEMO-CURSOR CURSOR FOR
             SELECT AMOUNT FROM DB2SQL_DEMO
             WHERE ID >= :HV-ID :HV-ID-IND
               AND ID <= 'T0000002'
             ORDER BY ID FOR FETCH ONLY
           END-EXEC.
       PROCEDURE DIVISION.
           EXEC SQL DELETE FROM DB2SQL_DEMO
             WHERE ID IN ('T0000001', 'T0000002')
           END-EXEC.
           EXEC SQL INSERT INTO DB2SQL_DEMO (ID, AMOUNT)
             VALUES (:HV-ID, :HV-AMOUNT)
           END-EXEC.
           IF SQLCODE NOT = 0 PERFORM FAILED END-IF.
           MOVE 'T0000002' TO HV-ID.
           MOVE 20 TO HV-AMOUNT.
           EXEC SQL INSERT INTO DB2SQL_DEMO (ID, AMOUNT)
             VALUES (:HV-ID, :HV-AMOUNT)
           END-EXEC.
           IF SQLCODE NOT = 0 PERFORM FAILED END-IF.
           MOVE 'T0000001' TO HV-ID.
           MOVE 11 TO HV-AMOUNT.
           EXEC SQL UPDATE DB2SQL_DEMO SET AMOUNT = :HV-AMOUNT
             WHERE ID = :HV-ID
           END-EXEC.
           IF SQLCODE NOT = 0 PERFORM FAILED END-IF.
           EXEC SQL OPEN DEMO-CURSOR END-EXEC.
           IF SQLCODE NOT = 0 PERFORM FAILED END-IF.
           EXEC SQL FETCH FROM DEMO-CURSOR
             INTO :HV-FOUND :HV-NULL-IND END-EXEC.
           IF SQLCODE NOT = 0 OR HV-FOUND NOT = 11
               OR HV-NULL-IND NOT = 0
               PERFORM FAILED
           END-IF.
           EXEC SQL FETCH DEMO-CURSOR
             INTO :HV-FOUND :HV-NULL-IND END-EXEC.
           IF SQLCODE NOT = 0 OR HV-FOUND NOT = 20
               OR HV-NULL-IND NOT = 0
               PERFORM FAILED
           END-IF.
           EXEC SQL FETCH DEMO-CURSOR
             INTO :HV-FOUND :HV-NULL-IND END-EXEC.
           IF SQLCODE NOT = 100 OR SQLSTATE NOT = '02000'
               PERFORM FAILED
           END-IF.
           EXEC SQL CLOSE DEMO-CURSOR END-EXEC.
           IF SQLCODE NOT = 0 PERFORM FAILED END-IF.
           MOVE 'T0000002' TO HV-ID.
           EXEC SQL DELETE FROM DB2SQL_DEMO WHERE ID = :HV-ID
           END-EXEC.
           IF SQLCODE NOT = 0 PERFORM FAILED END-IF.
           EXEC SQL COMMIT WORK END-EXEC.
           IF SQLCODE NOT = 0 PERFORM FAILED END-IF.
           MOVE 'T0000001' TO HV-ID.
           MOVE 99 TO HV-AMOUNT.
           EXEC SQL UPDATE DB2SQL_DEMO SET AMOUNT = :HV-AMOUNT
             WHERE ID = :HV-ID
           END-EXEC.
           IF SQLCODE NOT = 0 PERFORM FAILED END-IF.
           EXEC SQL ROLLBACK WORK END-EXEC.
           IF SQLCODE NOT = 0 PERFORM FAILED END-IF.
           EXEC SQL SELECT AMOUNT INTO :HV-FOUND
             FROM DB2SQL_DEMO WHERE ID = :HV-ID
           END-EXEC.
           IF SQLCODE NOT = 0 OR HV-FOUND NOT = 11
               PERFORM FAILED
           END-IF.
           EXEC SQL
             SELECT CAST(:HV-DEC AS DECIMAL(12,2))
               INTO :HV-DEC-FOUND FROM SYSIBM.SYSDUMMY1
           END-EXEC.
           IF SQLCODE NOT = 0 OR HV-DEC-FOUND NOT = 123.45
               PERFORM FAILED
           END-IF.
           EXEC SQL SELECT CAST(NULL AS INTEGER)
             INTO :HV-FOUND FROM SYSIBM.SYSDUMMY1
           END-EXEC.
           IF SQLCODE NOT = -305 OR SQLSTATE NOT = '22002'
               PERFORM FAILED
           END-IF.
           EXEC SQL SELECT CAST(NULL AS INTEGER)
             INTO :HV-FOUND :HV-NULL-IND
             FROM SYSIBM.SYSDUMMY1
           END-EXEC.
           IF SQLCODE NOT = 0 OR HV-NULL-IND NOT = -1
               PERFORM FAILED
           END-IF.
           EXEC SQL SELECT CASE WHEN
             CAST(:HV-FOUND :HV-NULL-IND AS INTEGER) IS NULL
             THEN 1 ELSE 0 END INTO :HV-TEST
             FROM SYSIBM.SYSDUMMY1
           END-EXEC.
           IF SQLCODE NOT = 0 OR HV-TEST NOT = 1
               PERFORM FAILED
           END-IF.
           EXEC SQL SELECT 7 INTO :HV-FOUND :HV-NULL-IND
             FROM SYSIBM.SYSDUMMY1
           END-EXEC.
           IF SQLCODE NOT = 0 OR HV-FOUND NOT = 7
               OR HV-NULL-IND NOT = 0
               PERFORM FAILED
           END-IF.
           EXEC SQL DELETE FROM DB2SQL_DEMO WHERE ID = :HV-ID
           END-EXEC.
           EXEC SQL COMMIT WORK END-EXEC.
           MOVE 'MISSING' TO HV-ID.
           EXEC SQL DELETE FROM DB2SQL_DEMO WHERE ID = :HV-ID
           END-EXEC.
           IF SQLCODE NOT = 100 OR SQLSTATE NOT = '02000'
               PERFORM FAILED
           END-IF.
           DISPLAY 'DB2 PHASE 2 OK'.
           MOVE 0 TO RETURN-CODE.
           STOP RUN.
       FAILED.
           DISPLAY 'PHASE 2 FAILED ' SQLCODE ' ' SQLSTATE.
           MOVE 1 TO RETURN-CODE.
           STOP RUN.
