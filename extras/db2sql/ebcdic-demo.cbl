       IDENTIFICATION DIVISION.
       PROGRAM-ID. DB2EBCDICDEMO.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 HV-TEXT PIC X(8) VALUE '日本語'.
       01 HV-RESULT PIC X(8).
       01 HV-SHORT PIC X(4).
       01 HV-HEX PIC X(64).
           EXEC SQL INCLUDE SQLCA END-EXEC.
       PROCEDURE DIVISION.
           EXEC SQL
             SELECT CAST(:HV-TEXT AS VARCHAR(32))
               INTO :HV-RESULT FROM SYSIBM.SYSDUMMY1
           END-EXEC.
           IF SQLCODE NOT = 0 OR HV-RESULT NOT = HV-TEXT
               PERFORM FAILED
           END-IF.
           EXEC SQL
             SELECT HEX(RTRIM(CAST(:HV-TEXT AS VARCHAR(32))))
               INTO :HV-HEX FROM SYSIBM.SYSDUMMY1
           END-EXEC.
           IF SQLCODE NOT = 0 OR
              HV-HEX NOT = 'E697A5E69CACE8AA9E'
               PERFORM FAILED
           END-IF.
           EXEC SQL
             SELECT CAST(:HV-TEXT AS VARCHAR(32))
               INTO :HV-SHORT FROM SYSIBM.SYSDUMMY1
           END-EXEC.
           IF SQLCODE NOT = -99992 OR SQLSTATE NOT = '22001'
               PERFORM FAILED
           END-IF.
           DISPLAY 'DB2 EBCDIC OK'.
           MOVE 0 TO RETURN-CODE.
           STOP RUN.
       FAILED.
           DISPLAY 'DB2 EBCDIC FAILED ' SQLCODE ' ' SQLSTATE.
           MOVE 1 TO RETURN-CODE.
           STOP RUN.
