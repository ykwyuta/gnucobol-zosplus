//VSQLTEST JOB 'SQL VSAM'
//DEFINE   EXEC PGM=IDCAMS
//SYSIN    DD *
 DEFINE CLUSTER(NAME(TEST.VSAM.KSDS) RECORDSIZE(12 12) KEYS(4 2))
/*
//SYSPRINT DD SYSOUT=*
//IMPORT   EXEC PGM=IDCAMS
//IN       DD DSN=TEST.VSAM.INPUT,DISP=SHR
//OUT      DD DSN=TEST.VSAM.KSDS,DISP=SHR
//SYSIN    DD *
 REPRO INFILE(IN) OUTFILE(OUT)
/*
//SYSPRINT DD SYSOUT=*
//AIXDEF   EXEC PGM=IDCAMS
//SYSIN    DD *
 DEFINE ALTERNATEINDEX(NAME(TEST.VSAM.AIX) RELATE(TEST.VSAM.KSDS) KEYS(2 6) UNIQUEKEY)
/*
//SYSPRINT DD SYSOUT=*
//BLDINDEX EXEC PGM=IDCAMS
//SYSIN    DD *
 BLDINDEX INDATASET(TEST.VSAM.KSDS) OUTDATASET(TEST.VSAM.AIX)
/*
//SYSPRINT DD SYSOUT=*
//EXPORT   EXEC PGM=IDCAMS
//IN       DD DSN=TEST.VSAM.KSDS,DISP=SHR
//OUT      DD DSN=TEST.VSAM.OUTPUT,DISP=(NEW,CATLG)
//SYSIN    DD *
 REPRO INFILE(IN) OUTFILE(OUT)
/*
//SYSPRINT DD SYSOUT=*
//DELETE   EXEC PGM=IDCAMS
//SYSIN    DD *
 DELETE TEST.VSAM.KSDS
/*
//SYSPRINT DD SYSOUT=*
