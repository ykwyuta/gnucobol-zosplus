//SORTSYM JOB 'CARDDEMO SORT CARDS'
//FILTER EXEC PGM=SORT
//SORTIN DD DSN=TEST.SYMIN,DISP=SHR
//SORTOUT DD DSN=TEST.SYMOUT,DISP=(NEW,CATLG)
//SYMNAMES DD *
TRAN-CARD-NUM,263,16,ZD
TRAN-PROC-DT,305,10,CH
PARM-START-DATE,C'2022-06-01'
PARM-END-DATE,C'2022-06-30'
//SYSIN DD *
 SORT FIELDS=(TRAN-CARD-NUM,A)
 INCLUDE COND=(TRAN-PROC-DT,GE,PARM-START-DATE,AND,
         TRAN-PROC-DT,LE,PARM-END-DATE)
/*
//SYSOUT DD SYSOUT=*
//REFORMAT EXEC PGM=SORT
//SORTIN DD DSN=TEST.SYMOUT,DISP=SHR
//SORTOUT DD DSN=TEST.REPORT,DISP=(NEW,CATLG)
//SYSIN DD *
 SORT FIELDS=(263,16,CH,A,1,16,CH,A)
 OUTREC FIELDS=(1:263,16,17:1,262,279:279,50)
/*
//SYSOUT DD SYSOUT=*
