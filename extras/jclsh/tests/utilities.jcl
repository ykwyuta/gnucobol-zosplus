//UTILTEST JOB 'RUST UTILITIES'
//COPYIN   EXEC PGM=IEBGENER
//SYSUT1   DD *
C03
A01
B02
/*
//SYSUT2   DD DSN=TEST.INPUT,DISP=(NEW,CATLG)
//SYSIN    DD DUMMY
//SYSPRINT DD SYSOUT=*
//ORDER    EXEC PGM=SORT
//SORTIN   DD DSN=TEST.INPUT,DISP=SHR
//SORTOUT  DD DSN=TEST.SORTED,DISP=(NEW,CATLG)
//SYSIN    DD *
 SORT FIELDS=(1,3,CH,A)
/*
//SYSOUT   DD SYSOUT=*
//DEFINE   EXEC PGM=IDCAMS
//SYSIN    DD *
 DEFINE CLUSTER(NAME(TEST.COPY))
/*
//SYSPRINT DD SYSOUT=*
//REPRO    EXEC PGM=IDCAMS
//IN       DD DSN=TEST.SORTED,DISP=SHR
//OUT      DD DSN=TEST.COPY,DISP=SHR
//SYSIN    DD *
 REPRO INFILE(IN) OUTFILE(OUT)
/*
//SYSPRINT DD SYSOUT=*
//CATALOG  EXEC PGM=IDCAMS
//SYSIN    DD *
 LISTCAT LEVEL(TEST.)
/*
//SYSPRINT DD SYSOUT=*
//CLEANUP  EXEC PGM=IEFBR14
//DROP     DD DSN=TEST.COPY,DISP=(OLD,DELETE)
