       IDENTIFICATION DIVISION.
       PROGRAM-ID. GENAPP-API-WORKER.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 EIBAID PIC X.
       01 EIBCALEN PIC S9(4) COMP.
       01 EIBCALEN-BYTES REDEFINES EIBCALEN PIC X(2).
       01 EIBTRNID PIC X(4).
       01 LINK-CAPACITY PIC X(2).
       01 OUTPUT-LENGTH PIC S9(4) COMP VALUE 2048.
       01 ROLLBACK-MODE PIC X VALUE X'01'.
       01 API-RESP PIC S9(8) COMP.
       01 API-RESP2 PIC S9(8) COMP.
       01 DFHCOMMAREA PIC X(32500).
       PROCEDURE DIVISION.
           CALL STATIC "COBCICS_START"
             USING EIBAID EIBCALEN EIBTRNID
           CALL STATIC "COBCICS_GET_COMMAREA"
             USING DFHCOMMAREA EIBCALEN
           MOVE EIBCALEN-BYTES TO LINK-CAPACITY
           CALL STATIC "COBCICS_LINK_ENTER"
             USING EIBCALEN LINK-CAPACITY
           CALL STATIC "COBCICS_LINK_CALLER"
             USING "GENAPI  "
           EVALUATE EIBTRNID
             WHEN "GICU"
               CALL STATIC "LGICUS01" USING DFHCOMMAREA
             WHEN "GIPU"
               CALL STATIC "LGIPOL01" USING DFHCOMMAREA
             WHEN "GACU"
               CALL STATIC "LGACUS01" USING DFHCOMMAREA
             WHEN "GAPU"
               CALL STATIC "LGAPOL01" USING DFHCOMMAREA
             WHEN OTHER
               DISPLAY "unsupported GenApp API transaction"
                 UPON STDERR
               MOVE "99" TO DFHCOMMAREA(7:2)
           END-EVALUATE
           CALL STATIC "COBCICS_LINK_EXIT"
           IF DFHCOMMAREA(7:2) NOT = "00"
             CALL STATIC "COBCICS_SYNCPOINT"
               USING ROLLBACK-MODE API-RESP API-RESP2
           END-IF
           CALL STATIC "COBCICS_SET_RETURN"
             USING "APIR" DFHCOMMAREA OUTPUT-LENGTH
           CALL STATIC "COBCICS_FINISH"
           GOBACK.
