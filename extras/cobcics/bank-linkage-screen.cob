       IDENTIFICATION DIVISION.
       PROGRAM-ID. BNKLINK.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WS-AID PIC X.
       01 WS-CALEN PIC S9(4) COMP.
       01 WS-TRANSID PIC X(4).
       01 WS-CAPACITY PIC S9(4) COMP VALUE 2048.
       01 WS-COMMAREA PIC X(2048).
       PROCEDURE DIVISION.
           CALL STATIC "COBCICS_START"
             USING WS-AID WS-CALEN WS-TRANSID
           CALL STATIC "COBCICS_GET_COMMAREA"
             USING WS-COMMAREA WS-CAPACITY
           MOVE 2048 TO WS-CAPACITY
           CALL STATIC "COBCICS_SCREEN_ENTER"
             USING WS-CALEN WS-CAPACITY
           EVALUATE WS-TRANSID
             WHEN "ODCS"
               CALL "BNK1DCS" USING WS-COMMAREA
             WHEN "OCRA"
               CALL "BNK1CRA" USING WS-COMMAREA
             WHEN OTHER
               DISPLAY "unsupported linkage screen" UPON STDERR
               MOVE 12 TO RETURN-CODE
               GOBACK
           END-EVALUATE
           CALL STATIC "COBCICS_LINK_EXIT"
           CALL STATIC "COBCICS_FINISH"
           GOBACK.
