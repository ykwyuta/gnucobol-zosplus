       IDENTIFICATION DIVISION.
       PROGRAM-ID. JPDEMO.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 EIBAID PIC X.
       01 EIBCALEN PIC S9(4) COMP.
       01 EIBTRNID PIC X(4).
       01 WS-ACTION PIC X(20).
       01 WS-ACTION-LEN PIC S9(4) COMP.
       01 WS-ACTION-FLAG PIC X.
       01 WS-MESSAGE PIC X(32).
       01 WS-MESSAGE-LEN PIC S9(4) COMP.
       01 WS-COMMAREA PIC X VALUE 'Y'.
       PROCEDURE DIVISION.
           CALL STATIC "COBCICS_START"
             USING EIBAID EIBCALEN EIBTRNID.
           MOVE SPACES TO WS-MESSAGE.
           IF EIBCALEN = ZERO
               MOVE '日本語を入力' TO WS-MESSAGE
           ELSE
               MOVE LENGTH OF WS-ACTION TO WS-ACTION-LEN
               CALL STATIC "COBCICS_GET_FIELD"
                 USING "ACTION  " WS-ACTION
                       WS-ACTION-LEN WS-ACTION-FLAG
               MOVE WS-ACTION TO WS-MESSAGE
           END-IF.
           MOVE LENGTH OF WS-MESSAGE TO WS-MESSAGE-LEN.
           CALL STATIC "COBCICS_SEND_FIELD"
             USING "MESSAGE " WS-MESSAGE WS-MESSAGE-LEN.
           IF EIBAID NOT = X'F3'
               MOVE 1 TO WS-ACTION-LEN
               CALL STATIC "COBCICS_SET_RETURN"
                 USING "JP01" WS-COMMAREA WS-ACTION-LEN
           END-IF.
           CALL STATIC "COBCICS_FINISH".
           GOBACK.
