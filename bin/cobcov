#!/usr/bin/env python3
"""Merge and report GnuCOBOL source branch coverage."""

import argparse
import collections
import json
import pathlib
import re
import sys


BUILD_ID = re.compile(r"[0-9a-f]{16}\Z")


def files_at(path, pattern):
    path = pathlib.Path(path)
    if path.is_file():
        return [path]
    if path.is_dir():
        return sorted(path.glob(pattern))
    raise ValueError(f"not found: {path}")


def read_maps(path):
    maps = {}
    for filename in files_at(path, "cobcov-*.json"):
        data = json.loads(filename.read_text(encoding="utf-8"))
        build_id = data.get("build_id")
        if data.get("version") != 1 or not isinstance(build_id, str) or not BUILD_ID.fullmatch(build_id):
            raise ValueError(f"invalid map: {filename}")
        if build_id in maps:
            raise ValueError(f"duplicate build ID: {build_id}")
        outcomes = data.get("outcomes")
        if not isinstance(outcomes, list) or len({o["id"] for o in outcomes}) != len(outcomes):
            raise ValueError(f"invalid outcomes: {filename}")
        maps[build_id] = data
    if not maps:
        raise ValueError(f"no coverage maps found at {path}")
    return maps


def read_counts(path, maps):
    counts = {(build_id, outcome["id"]): 0
              for build_id, data in maps.items() for outcome in data["outcomes"]}
    files = files_at(path, "*.counts") if pathlib.Path(path).exists() else []
    for filename in files:
        lines = filename.read_text(encoding="ascii").splitlines()
        if not lines or lines[0] != "COBCOV1":
            raise ValueError(f"invalid counter file: {filename}")
        for line in lines[1:]:
            pieces = line.split("\t")
            if len(pieces) != 3:
                raise ValueError(f"invalid counter row: {filename}: {line}")
            build_id, outcome_id, value = pieces
            try:
                key = (build_id, int(outcome_id))
                amount = int(value)
            except ValueError as exc:
                raise ValueError(f"invalid counter row: {filename}: {line}") from exc
            if key not in counts or amount < 0:
                raise ValueError(f"counter does not match map: {filename}: {line}")
            counts[key] += amount
    return counts, len(files)


def report(args):
    maps = read_maps(args.maps)
    counts, runs = read_counts(args.data, maps)
    rows = []
    for build_id, data in maps.items():
        for outcome in data["outcomes"]:
            rows.append({**outcome, "build_id": build_id,
                         "count": counts[(build_id, outcome["id"])]})
    total = len(rows)
    covered = sum(row["count"] > 0 for row in rows)
    percent = 100.0 * covered / total if total else None
    kinds = sorted({row["kind"] for row in rows})
    result = {"scope": kinds, "covered": covered, "total": total,
              "percent": percent, "counter_files": runs, "outcomes": rows}
    if args.format == "json":
        print(json.dumps(result, ensure_ascii=False, indent=2))
    elif args.format == "lcov":
        by_file = collections.defaultdict(list)
        blocks = {}
        branch_numbers = collections.defaultdict(int)
        for row in rows:
            decision = (row["build_id"], row.get("decision", row["id"] // 2))
            if decision not in blocks:
                blocks[decision] = len(blocks)
            branch = branch_numbers[decision]
            branch_numbers[decision] += 1
            by_file[row["file"]].append((row, blocks[decision], branch))
        for filename, entries in sorted(by_file.items()):
            print(f"SF:{filename}")
            for row, block, branch in entries:
                print(f"BRDA:{row['line']},{block},{branch},{row['count']}")
            print(f"BRF:{len(entries)}")
            print(f"BRH:{sum(row['count'] > 0 for row, _, _ in entries)}")
            print("end_of_record")
    else:
        rate = f"{percent:.1f}%" if percent is not None else "n/a"
        scope = "IF" if kinds == ["IF"] else ", ".join(kinds) or "none"
        print(f"COBOL {scope} branches: {covered}/{total} ({rate}), {runs} counter file(s)")
        for row in rows:
            print(f"{row['file']}:{row['line']}:{row['column']} "
                  f"{row['program']} {row['kind']} #{row.get('decision', row['id'] // 2)} "
                  f"{row['result']}: {row['count']}")
    if args.fail_under_branches is not None and (percent is None or percent < args.fail_under_branches):
        return 1
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    cmd = sub.add_parser("report", help="merge COBOL branch counter files")
    cmd.add_argument("maps", help="coverage map file or directory")
    cmd.add_argument("data", help="counter file or directory")
    cmd.add_argument("--format", choices=("text", "json", "lcov"), default="text")
    cmd.add_argument("--fail-under-branches", type=float)
    args = parser.parse_args()
    try:
        return report(args)
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as exc:
        parser.error(str(exc))


if __name__ == "__main__":
    sys.exit(main())
