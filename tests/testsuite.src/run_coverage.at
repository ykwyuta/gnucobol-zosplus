AT_DATA([file-other-error.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. OTHERERR.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT INPUT-FILE ASSIGN TO 'input.dat'
             ORGANIZATION LINE SEQUENTIAL
             FILE STATUS IS FILE-STATUS.
       DATA DIVISION.
       FILE SECTION.
       FD INPUT-FILE.
       01 INPUT-RECORD PIC X.
       WORKING-STORAGE SECTION.
       01 FILE-STATUS PIC XX.
       PROCEDURE DIVISION.
           OPEN INPUT INPUT-FILE.
           PERFORM READ-INPUT.
           CLOSE INPUT-FILE.
           PERFORM READ-INPUT.
           DISPLAY FILE-STATUS.
           STOP RUN.
       READ-INPUT.
           READ INPUT-FILE
             AT END DISPLAY 'BAD'
           END-READ.
])

