AT_SETUP([COBOL CALL ON EXCEPTION branch coverage])
AT_KEYWORDS([coverage cobc])
AT_SKIP_IF([! command -v python3 >/dev/null 2>&1])

AT_DATA([caller.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. CALLCOV.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 TARGET-NAME PIC X(20).
       PROCEDURE DIVISION.
           ACCEPT TARGET-NAME FROM ENVIRONMENT 'TARGET'.
           CALL TARGET-NAME
             ON EXCEPTION PERFORM CALL-MISSING
             NOT ON EXCEPTION PERFORM CALL-OK
           END-CALL.
           STOP RUN.
       CALL-MISSING.
           DISPLAY 'MISSING'.
       CALL-OK.
           DISPLAY 'OK'.
])
AT_DATA([callee.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. callee.
       PROCEDURE DIVISION.
           GOBACK.
])

AT_CHECK([$COMPILE --cobol-branch-coverage caller.cob])
AT_CHECK([$COMPILE_MODULE callee.cob])
AT_CHECK([TARGET=missing COB_COVERAGE_DIR=. COB_LIBRARY_PATH=. $COBCRUN_DIRECT ./caller], [0], [MISSING
])
AT_CHECK([TARGET=callee COB_COVERAGE_DIR=. COB_LIBRARY_PATH=. $COBCRUN_DIRECT ./caller], [0], [OK
])
AT_CHECK([python3 "$abs_top_srcdir/bin/cobcov" report . .], [0],
