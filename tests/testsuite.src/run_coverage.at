perform.cob:11:0 PERFCOV PERFORM TIMES #1 zero: 1
perform.cob:11:0 PERFCOV PERFORM TIMES #1 one-or-more: 0
perform.cob:12:0 PERFCOV PERFORM TIMES #2 zero: 0
perform.cob:12:0 PERFCOV PERFORM TIMES #2 one-or-more: 1
])
AT_CLEANUP

AT_SETUP([COBOL mixed IF and EVALUATE branch coverage])
AT_KEYWORDS([coverage cobc])
AT_SKIP_IF([! command -v python3 >/dev/null 2>&1])

AT_DATA([mixed.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. MIXED.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 X PIC 9 VALUE 1.
       PROCEDURE DIVISION.
           IF X = 1
               EVALUATE X
                 WHEN 1 DISPLAY 'HIT'
                 WHEN OTHER DISPLAY 'BAD'
               END-EVALUATE
           END-IF.
           STOP RUN.
])

AT_CHECK([$COMPILE --cobol-branch-coverage mixed.cob])
AT_CHECK([COB_COVERAGE_DIR=. $COBCRUN_DIRECT ./mixed], [0], [HIT
])
AT_CHECK([python3 "$abs_top_srcdir/bin/cobcov" report . .], [0],
[COBOL EVALUATE, IF branches: 2/4 (50.0%), 1 counter file(s)
mixed.cob:8:0 MIXED IF #0 true: 1
mixed.cob:8:0 MIXED IF #0 false: 0
mixed.cob:10:0 MIXED EVALUATE #1 WHEN 1: 1
mixed.cob:11:0 MIXED EVALUATE #1 WHEN OTHER: 0
])
AT_CLEANUP

AT_SETUP([COBOL EVALUATE branch coverage OTHER THRU and TRUE])
AT_KEYWORDS([coverage cobc])
AT_SKIP_IF([! command -v python3 >/dev/null 2>&1])

AT_DATA([evaluate-extra.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. EVALMORE.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 X PIC 99 VALUE 9.
       PROCEDURE DIVISION.
           EVALUATE X
             WHEN 1 THRU 3 DISPLAY 'BAD'
             WHEN OTHER DISPLAY 'OTHER'
           END-EVALUATE.
           EVALUATE TRUE
             WHEN X > 9 DISPLAY 'BAD'
             WHEN X > 5 DISPLAY 'TRUE'
           END-EVALUATE.
           STOP RUN.
])

AT_CHECK([$COMPILE --cobol-branch-coverage evaluate-extra.cob])
AT_CHECK([COB_COVERAGE_DIR=. $COBCRUN_DIRECT ./evaluate-extra], [0], [OTHER
TRUE
])
AT_CHECK([python3 "$abs_top_srcdir/bin/cobcov" report . .], [0],
[COBOL EVALUATE branches: 2/5 (40.0%), 1 counter file(s)
evaluate-extra.cob:9:0 EVALMORE EVALUATE #0 WHEN 1: 0
evaluate-extra.cob:10:0 EVALMORE EVALUATE #0 WHEN OTHER: 1
evaluate-extra.cob:13:0 EVALMORE EVALUATE #1 WHEN 1: 0
evaluate-extra.cob:14:0 EVALMORE EVALUATE #1 WHEN 2: 1
evaluate-extra.cob:12:0 EVALMORE EVALUATE #1 unmatched: 0
])
AT_CLEANUP

AT_SETUP([COBOL EVALUATE branch coverage])
AT_KEYWORDS([coverage cobc])
AT_SKIP_IF([! command -v python3 >/dev/null 2>&1])

AT_DATA([evaluate.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. EVALCOV.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 X PIC 9 VALUE 2.
       01 Y PIC 9 VALUE 1.
       PROCEDURE DIVISION.
           EVALUATE X ALSO Y
             WHEN 1 ALSO 1 DISPLAY 'BAD'
             WHEN 2 ALSO 0
             WHEN 2 ALSO 1 DISPLAY 'HIT'
             WHEN OTHER DISPLAY 'BAD'
           END-EVALUATE.
           MOVE 9 TO X.
           EVALUATE X
             WHEN 1 DISPLAY 'BAD'
             WHEN 2 DISPLAY 'BAD'
           END-EVALUATE.
           STOP RUN.
])

AT_CHECK([$COMPILE --cobol-branch-coverage evaluate.cob])
AT_CHECK([COB_COVERAGE_DIR=. $COBCRUN_DIRECT ./evaluate], [0], [HIT
])
AT_CHECK([python3 "$abs_top_srcdir/bin/cobcov" report . .], [0],
[COBOL EVALUATE branches: 2/7 (28.6%), 1 counter file(s)
evaluate.cob:10:0 EVALCOV EVALUATE #0 WHEN 1: 0
evaluate.cob:11:0 EVALCOV EVALUATE #0 WHEN 2: 0
evaluate.cob:12:0 EVALCOV EVALUATE #0 WHEN 3: 1
evaluate.cob:13:0 EVALCOV EVALUATE #0 WHEN OTHER: 0
evaluate.cob:17:0 EVALCOV EVALUATE #1 WHEN 1: 0
evaluate.cob:18:0 EVALCOV EVALUATE #1 WHEN 2: 0
evaluate.cob:16:0 EVALCOV EVALUATE #1 unmatched: 1
])
AT_CLEANUP

AT_SETUP([COBOL IF branch coverage nested and COPY])
AT_KEYWORDS([coverage cobc])
AT_SKIP_IF([! command -v python3 >/dev/null 2>&1])

AT_DATA([branch.cpy], [
           IF X = 1 DISPLAY 'BAD' END-IF.
])
AT_DATA([nested.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. NESTED.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 X PIC 9 VALUE 0.
       PROCEDURE DIVISION.
           IF X = 0
               IF X = 1 DISPLAY 'BAD' END-IF
           ELSE
               DISPLAY 'BAD'
           END-IF.
           COPY 'branch.cpy'.
           IF X = 1 CONTINUE END-IF IF X = 0 CONTINUE END-IF.
           DISPLAY 'OK'.
           STOP RUN.
])

AT_CHECK([$COMPILE --cobol-branch-coverage nested.cob])
AT_CHECK([COB_COVERAGE_DIR=. $COBCRUN_DIRECT ./nested], [0], [OK
])
AT_CHECK([python3 "$abs_top_srcdir/bin/cobcov" report . .], [0],
[COBOL IF branches: 5/10 (50.0%), 1 counter file(s)
nested.cob:8:0 NESTED IF #0 true: 1
nested.cob:8:0 NESTED IF #0 false: 0
nested.cob:9:0 NESTED IF #1 true: 0
nested.cob:9:0 NESTED IF #1 false: 1
branch.cpy:2:0 NESTED IF #2 true: 0
branch.cpy:2:0 NESTED IF #2 false: 1
nested.cob:14:0 NESTED IF #3 true: 0
nested.cob:14:0 NESTED IF #3 false: 1
nested.cob:14:0 NESTED IF #4 true: 1
nested.cob:14:0 NESTED IF #4 false: 0
])
AT_CLEANUP
