[COBOL SEARCH branches: 4/5 (80.0%), 1 counter file(s)
search.cob:20:0 SEARCHCOV SEARCH #0 WHEN 1: 0
search.cob:21:0 SEARCHCOV SEARCH #0 unmatched: 1
search.cob:26:0 SEARCHCOV SEARCH #1 WHEN 1: 1
search.cob:27:0 SEARCHCOV SEARCH #1 WHEN 2: 1
search.cob:25:0 SEARCHCOV SEARCH #1 AT END: 1
])
