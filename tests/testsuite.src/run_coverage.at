AT_SETUP([COBOL SEARCH ALL branch coverage])
AT_KEYWORDS([coverage cobc])
AT_SKIP_IF([! command -v python3 >/dev/null 2>&1])

AT_DATA([search-all.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. SEARCHALL.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 T.
          02 E OCCURS 3 ASCENDING KEY V INDEXED BY I.
             03 V PIC 9.
       PROCEDURE DIVISION.
           MOVE 1 TO V(1).
           MOVE 2 TO V(2).
           MOVE 3 TO V(3).
           SEARCH ALL E
             AT END DISPLAY 'BAD'
             WHEN V(I) = 2 DISPLAY 'FOUND'
           END-SEARCH.
           SEARCH ALL E
             AT END DISPLAY 'MISSING'
             WHEN V(I) = 9 DISPLAY 'BAD'
           END-SEARCH.
           STOP RUN.
])

AT_CHECK([$COMPILE --cobol-branch-coverage search-all.cob])
AT_CHECK([COB_COVERAGE_DIR=. $COBCRUN_DIRECT ./search-all], [0], [FOUND
MISSING
])
