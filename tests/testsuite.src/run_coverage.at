AT_SETUP([COBOL IF branch coverage])
AT_KEYWORDS([coverage cobc])
AT_SKIP_IF([! command -v python3 >/dev/null 2>&1])

AT_DATA([prog.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. PROG.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 X PIC 9 VALUE 0.
       PROCEDURE DIVISION.
           IF X = 0 DISPLAY 'TRUE' END-IF.
           IF X = 1
               DISPLAY 'BAD'
           ELSE
               DISPLAY 'FALSE'
           END-IF.
           STOP RUN.
])

AT_CHECK([$COMPILE --cobol-branch-coverage prog.cob])
AT_CHECK([COB_COVERAGE_DIR=. $COBCRUN_DIRECT ./prog], [0], [TRUE
FALSE
])
AT_CHECK([python3 "$abs_top_srcdir/bin/cobcov" report . .], [0],
[COBOL IF branches: 2/4 (50.0%), 1 counter file(s)
prog.cob:8:0 PROG IF #0 true: 1
prog.cob:8:0 PROG IF #0 false: 0
prog.cob:9:0 PROG IF #1 true: 0
prog.cob:9:0 PROG IF #1 false: 1
])
AT_CLEANUP

AT_SETUP([COBOL JSON exception branch coverage])
AT_KEYWORDS([coverage cobc JSON-CODE])
AT_SKIP_IF([! command -v python3 >/dev/null 2>&1])
AT_SKIP_IF([test "$COB_HAS_JSON" = "no"])

AT_DATA([json-exception.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. JSONCOV.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 SHORT-STR PIC X(5).
       01 LONG-STR PIC X(200).
       01 VALID-REC.
          03 A PIC XX VALUE 'aa'.
          03 B PIC XX VALUE 'bb'.
       PROCEDURE DIVISION.
           JSON GENERATE SHORT-STR FROM VALID-REC
             ON EXCEPTION DISPLAY 'EXCEPTION'
             NOT ON EXCEPTION DISPLAY 'BAD'
           END-JSON.
           JSON GENERATE LONG-STR FROM VALID-REC
             ON EXCEPTION DISPLAY 'BAD'
             NOT ON EXCEPTION DISPLAY 'NORMAL'
           END-JSON.
           STOP RUN.
])

AT_CHECK([$COMPILE --cobol-branch-coverage json-exception.cob])
AT_CHECK([COB_COVERAGE_DIR=. $COBCRUN_DIRECT ./json-exception], [0], [EXCEPTION
NORMAL
])
AT_CHECK([python3 "$abs_top_srcdir/bin/cobcov" report . .], [0],
[COBOL JSON EXCEPTION branches: 2/4 (50.0%), 1 counter file(s)
json-exception.cob:11:0 JSONCOV JSON EXCEPTION #0 exception: 1
json-exception.cob:11:0 JSONCOV JSON EXCEPTION #0 normal: 0
json-exception.cob:15:0 JSONCOV JSON EXCEPTION #1 exception: 0
json-exception.cob:15:0 JSONCOV JSON EXCEPTION #1 normal: 1
])
AT_CLEANUP

AT_SETUP([COBOL XML exception branch coverage])
AT_KEYWORDS([coverage cobc XML-CODE])
AT_SKIP_IF([! command -v python3 >/dev/null 2>&1])
AT_SKIP_IF([test "$COB_HAS_XML2" = "no"])

AT_DATA([xml-exception.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. XMLCOV.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 XML-INPUT PIC X(8) VALUE '<empty/>'.
       PROCEDURE DIVISION.
           PERFORM PARSE-INPUT.
           MOVE '</>' TO XML-INPUT.
           PERFORM PARSE-INPUT.
           STOP RUN.
       PARSE-INPUT.
           XML PARSE XML-INPUT
             PROCESSING PROCEDURE PROCESS-XML
             ON EXCEPTION DISPLAY 'EXCEPTION'
             NOT ON EXCEPTION DISPLAY 'NORMAL'
           END-XML.
       PROCESS-XML.
           CONTINUE.
])

AT_CHECK([$COMPILE --cobol-branch-coverage xml-exception.cob])
AT_CHECK([COB_COVERAGE_DIR=. $COBCRUN_DIRECT ./xml-exception], [0], [NORMAL
EXCEPTION
], [ignore])
AT_CHECK([python3 "$abs_top_srcdir/bin/cobcov" report . .], [0],
[COBOL XML EXCEPTION branches: 2/2 (100.0%), 1 counter file(s)
xml-exception.cob:12:0 XMLCOV XML EXCEPTION #0 exception: 1
xml-exception.cob:12:0 XMLCOV XML EXCEPTION #0 normal: 1
])
AT_CLEANUP

AT_SETUP([COBOL file AT EOP branch coverage])
AT_KEYWORDS([coverage cobc])
AT_SKIP_IF([! command -v python3 >/dev/null 2>&1])

AT_DATA([file-eop.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. EOPCOV.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT PRINT-FILE ASSIGN TO 'print.dat'.
       DATA DIVISION.
       FILE SECTION.
       FD PRINT-FILE LINAGE IS 2 LINES.
       01 PRINT-RECORD PIC X.
       PROCEDURE DIVISION.
           OPEN OUTPUT PRINT-FILE.
           MOVE 'A' TO PRINT-RECORD.
           PERFORM WRITE-ONE 4 TIMES.
           CLOSE PRINT-FILE.
           STOP RUN.
       WRITE-ONE.
           WRITE PRINT-RECORD AFTER ADVANCING 1 LINE
             END-OF-PAGE DISPLAY 'EOP'
           END-WRITE.
])

AT_CHECK([$COMPILE --cobol-branch-coverage file-eop.cob])
AT_CHECK([COB_COVERAGE_DIR=. $COBCRUN_DIRECT ./file-eop], [0], [EOP
EOP
])
AT_CHECK([python3 "$abs_top_srcdir/bin/cobcov" report . .], [0],
[COBOL AT EOP, PERFORM TIMES branches: 3/4 (75.0%), 1 counter file(s)
file-eop.cob:15:0 EOPCOV PERFORM TIMES #0 zero: 0
file-eop.cob:15:0 EOPCOV PERFORM TIMES #0 one-or-more: 1
file-eop.cob:19:0 EOPCOV AT EOP #1 handler: 2
file-eop.cob:19:0 EOPCOV AT EOP #1 normal: 2
])
AT_CLEANUP

AT_SETUP([COBOL file handler excludes unrelated errors])
