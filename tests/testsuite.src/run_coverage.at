AT_SETUP([COBOL SEARCH branch coverage])
AT_KEYWORDS([coverage cobc])
AT_SKIP_IF([! command -v python3 >/dev/null 2>&1])

AT_DATA([search.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. SEARCHCOV.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 T.
          02 E OCCURS 3 INDEXED BY I.
             03 V PIC 9.
       PROCEDURE DIVISION.
           MOVE 1 TO V(1).
           MOVE 2 TO V(2).
           MOVE 3 TO V(3).
           SET I TO 1.
           PERFORM FIND-IT.
           SET I TO 3.
           PERFORM FIND-IT.
           SET I TO 4.
           PERFORM FIND-IT.
           SEARCH E
             WHEN V(I) = 9 DISPLAY 'BAD'
           END-SEARCH.
           STOP RUN.
       FIND-IT.
           SEARCH E
             AT END DISPLAY 'END'
             WHEN V(I) = 2 DISPLAY 'TWO'
             WHEN V(I) = 3 DISPLAY 'THREE'
           END-SEARCH.
])

AT_CHECK([$COMPILE --cobol-branch-coverage search.cob])
AT_CHECK([COB_COVERAGE_DIR=. $COBCRUN_DIRECT ./search], [0], [TWO
THREE
END
])
