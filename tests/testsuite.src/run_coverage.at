AT_SETUP([COBOL file INVALID KEY branch coverage])
AT_KEYWORDS([coverage cobc])
AT_SKIP_IF([! command -v python3 >/dev/null 2>&1])

AT_DATA([file-invalid-key.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. KEYCOV.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT REL-FILE ASSIGN TO 'rel.dat'
             ORGANIZATION RELATIVE ACCESS DYNAMIC
             RELATIVE KEY REL-KEY.
       DATA DIVISION.
       FILE SECTION.
       FD REL-FILE.
       01 REL-RECORD PIC X.
       WORKING-STORAGE SECTION.
       01 REL-KEY PIC 9(2).
       PROCEDURE DIVISION.
           OPEN OUTPUT REL-FILE.
           MOVE 1 TO REL-KEY.
           MOVE 'A' TO REL-RECORD.
           WRITE REL-RECORD.
           CLOSE REL-FILE.
           OPEN INPUT REL-FILE.
           MOVE 1 TO REL-KEY.
           PERFORM READ-KEY.
           MOVE 9 TO REL-KEY.
           PERFORM READ-KEY.
           CLOSE REL-FILE.
           STOP RUN.
       READ-KEY.
           READ REL-FILE
             INVALID KEY DISPLAY 'MISSING'
             NOT INVALID KEY DISPLAY 'FOUND'
           END-READ.
])

AT_CHECK([$COMPILE --cobol-branch-coverage file-invalid-key.cob])
AT_CHECK([COB_COVERAGE_DIR=. $COBCRUN_DIRECT ./file-invalid-key], [0], [FOUND
MISSING
])
