AT_SETUP([COBOL one-sided SIZE ERROR branch coverage])
AT_KEYWORDS([coverage cobc])
AT_SKIP_IF([! command -v python3 >/dev/null 2>&1])

AT_DATA([size-one-sided.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. SIZEONE.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 DEN PIC 9 VALUE 2.
       01 RESULT-VALUE PIC 9.
       PROCEDURE DIVISION.
           DIVIDE 4 BY DEN GIVING RESULT-VALUE
             ON SIZE ERROR DISPLAY 'BAD'
           END-DIVIDE.
           MOVE 0 TO DEN.
           DIVIDE 4 BY DEN GIVING RESULT-VALUE
             NOT ON SIZE ERROR DISPLAY 'BAD'
           END-DIVIDE.
           STOP RUN.
])

