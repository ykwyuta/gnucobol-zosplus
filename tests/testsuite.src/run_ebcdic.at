AT_SETUP([EBCDIC data: numeric national items])
AT_KEYWORDS([ebcdic data-codeset national])

AT_DATA([prog.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 N1   PIC 9(4) USAGE NATIONAL.
       01 N2   PIC S9(3)V9 USAGE NATIONAL VALUE -1.5.
       01 N3   PIC -(4)9.99 USAGE NATIONAL.
       01 D1   PIC 9(4) VALUE 30.
       01 X1   PIC X(4).
       01 U1   PIC N(4) USAGE NATIONAL.
       PROCEDURE DIVISION.
           MOVE 5 TO N1
           DISPLAY '<' N1 '>'
           MOVE ZERO TO N1
           DISPLAY '<' N1 '>'
           MOVE 42 TO N1
           INITIALIZE N1
           DISPLAY '<' N1 '> <' N2 '> ' FUNCTION HEX-OF (N2)
           MOVE 13 TO N1
           IF N1 = 13 DISPLAY 'EQ13' END-IF
           ADD N1 TO D1
           DISPLAY D1
           SUBTRACT 20 FROM N2
           DISPLAY '<' N2 '>'
           DIVIDE N2 BY 2 GIVING N3 ROUNDED
           DISPLAY '<' N3 '>'
           MOVE N1 TO X1
           DISPLAY '<' X1 '>'
           MOVE N1 TO U1
           DISPLAY '<' U1 '> ' FUNCTION HEX-OF (U1)
           MOVE N3 TO N2
           DISPLAY '<' N2 '>'
           IF N1 NUMERIC DISPLAY 'NUMERIC' END-IF
           GOBACK.
])

AT_CHECK([$COMPILE -fdata-codeset=IBM-1399 prog.cob], [0], [], [])
AT_CHECK([COB_HOST_CODESET=UTF-8 $COBCRUN_DIRECT ./prog], [0],
