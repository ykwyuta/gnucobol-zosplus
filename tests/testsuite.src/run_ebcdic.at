AT_SETUP([EBCDIC data: CALL EXTFH])
AT_KEYWORDS([ebcdic data-codeset EXTFH FCD])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  FILE-NAME    PIC X(20) VALUE 'extfh.dat'.
       01  FH-ACTION    PIC X(2).
       01  REC          PIC X(10).
       01  FCD-AREA.
            COPY xfhfcd3.
       PROCEDURE        DIVISION.
           MOVE LOW-VALUES TO FCD-AREA
           MOVE LENGTH OF FCD-AREA TO FCD-LENGTH
           MOVE FCD--VERSION-NUMBER TO FCD-VERSION
           MOVE FCD--SEQUENTIAL-ORG TO FCD-ORGANIZATION
           MOVE 0 TO FCD-ACCESS-MODE
           MOVE 128 TO FCD-OPEN-MODE
           MOVE 0 TO FCD-RECORDING-MODE
           MOVE 9 TO FCD-NAME-LENGTH
           SET FCD-FILENAME-ADDRESS TO ADDRESS OF FILE-NAME
           SET FCD-RECORD-ADDRESS TO ADDRESS OF REC
           MOVE 10 TO FCD-MIN-REC-LENGTH FCD-MAX-REC-LENGTH
                      FCD-CURRENT-REC-LEN
      *>   OPEN INPUT of a missing file
           MOVE X'FA00' TO FH-ACTION
           CALL 'EXTFH' USING FH-ACTION FCD-AREA
           DISPLAY 'OPEN INPUT: ' FCD-FILE-STATUS
      *>   OPEN OUTPUT, WRITE, CLOSE
           MOVE X'FA01' TO FH-ACTION
           CALL 'EXTFH' USING FH-ACTION FCD-AREA
           DISPLAY 'OPEN OUTPUT: ' FCD-FILE-STATUS
           MOVE 'Record-1' TO REC
           MOVE X'FAF3' TO FH-ACTION
           CALL 'EXTFH' USING FH-ACTION FCD-AREA
           DISPLAY 'WRITE: ' FCD-FILE-STATUS
           MOVE X'FA80' TO FH-ACTION
           CALL 'EXTFH' USING FH-ACTION FCD-AREA
           DISPLAY 'CLOSE: ' FCD-FILE-STATUS
           DISPLAY '<' FILE-NAME (1:9) '>'
           STOP RUN.
])

AT_CHECK([$COMPILE -fnotrunc -fdata-codeset=IBM-037 prog.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./prog], [0],
[OPEN INPUT: 35
OPEN OUTPUT: 00
WRITE: 00
CLOSE: 00
<extfh.dat>
], [])
# the file name is in host charset, the data in EBCDIC
AT_CHECK([od -An -tx1 extfh.dat | tr -d ' \n'], [0],
[d9858396998460f14040], [])

AT_CLEANUP


AT_SETUP([EBCDIC data: comparison with national items])
AT_KEYWORDS([ebcdic data-codeset national])

AT_DATA([prog.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WU   PIC N(4) USAGE NATIONAL VALUE NC'東京'.
       01 WU2  PIC N(6) USAGE NATIONAL VALUE NC'東京'.
       01 WX   PIC X(10) VALUE '東京'.
       01 WA   PIC X(4) VALUE 'ab'.
       01 WUA  PIC N(4) USAGE NATIONAL VALUE NC'ab'.
       01 WG   PIC G(2) VALUE G'東京'.
       01 WS   PIC N(3) USAGE NATIONAL VALUE SPACES.
       PROCEDURE DIVISION.
           IF WU = WU2 DISPLAY '1 OK' ELSE DISPLAY '1 NG' END-IF
           IF WU = WX  DISPLAY '2 OK' ELSE DISPLAY '2 NG' END-IF
           IF WUA = WA DISPLAY '3 OK' ELSE DISPLAY '3 NG' END-IF
           IF WUA = 'ab' DISPLAY '4 OK' ELSE DISPLAY '4 NG' END-IF
           IF WU = NC'東京' DISPLAY '5 OK' ELSE DISPLAY '5 NG' END-IF
           IF WS = SPACE DISPLAY '6 OK' ELSE DISPLAY '6 NG' END-IF
           IF WU = WG  DISPLAY '7 OK' ELSE DISPLAY '7 NG' END-IF
           IF WUA < WU DISPLAY '8 OK' ELSE DISPLAY '8 NG' END-IF
           IF WG = G'東京' DISPLAY '9 OK' ELSE DISPLAY '9 NG' END-IF
           IF WS = ALL NC' ' DISPLAY '10 OK' ELSE DISPLAY '10 NG' END-IF
           IF WUA NOT = WA DISPLAY '11 NG' ELSE DISPLAY '11 OK' END-IF
           GOBACK.
])

AT_CHECK([$COMPILE -Wno-dialect -fdata-codeset=IBM-1399 prog.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./prog], [0],
[1 OK
2 OK
3 OK
4 OK
5 OK
6 OK
7 OK
8 OK
9 OK
10 OK
11 OK
], [])

AT_CLEANUP


AT_SETUP([EBCDIC data: STRING / UNSTRING / INSPECT with national items])
AT_KEYWORDS([ebcdic data-codeset national])

AT_DATA([prog.cob], [
       IDENTIFICATION DIVISION.
       PROGRAM-ID. prog.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 WU   PIC N(10) USAGE NATIONAL.
       01 WA   PIC N(4) USAGE NATIONAL VALUE NC'東京'.
       01 WB   PIC N(4) USAGE NATIONAL VALUE NC'大阪'.
       01 WX   PIC X(6) VALUE 'ab'.
       01 PTR  PIC 99.
       01 CNT  PIC 99.
       01 U1   PIC N(3) USAGE NATIONAL.
       01 U2   PIC N(3) USAGE NATIONAL.
       01 U3   PIC N(3) USAGE NATIONAL.
       01 D1   PIC N(1) USAGE NATIONAL.
       01 C1   PIC 99.
       01 TL   PIC 99.
       PROCEDURE DIVISION.
           MOVE 1 TO PTR
           STRING WA DELIMITED BY SPACE
                  NC'、' DELIMITED BY SIZE
                  WB DELIMITED BY SPACE
                  WX DELIMITED BY SPACE
                  INTO WU WITH POINTER PTR
           DISPLAY '<' WU '> ' PTR
           MOVE NC'東京、大阪、名古屋' TO WU
           MOVE 1 TO PTR
           UNSTRING WU DELIMITED BY NC'、'
                  INTO U1 DELIMITER IN D1 COUNT IN C1
                       U2 U3
                  WITH POINTER PTR TALLYING IN TL
           DISPLAY '<' U1 '><' U2 '><' U3 '><' D1 '> ' C1 ' ' PTR
                   ' ' TL
           MOVE 0 TO CNT
           INSPECT WU TALLYING CNT FOR ALL NC'、'
           DISPLAY 'ALL: ' CNT
           MOVE 0 TO CNT
           INSPECT WU TALLYING CNT FOR CHARACTERS BEFORE NC'名'
           DISPLAY 'CHARS BEFORE: ' CNT
           MOVE 0 TO CNT
           INSPECT WU TALLYING CNT FOR TRAILING SPACE
           DISPLAY 'TRAILING: ' CNT
           INSPECT WU REPLACING ALL NC'、' BY NC'・'
           DISPLAY '<' WU '>'
           INSPECT WU REPLACING CHARACTERS BY NC'＊' AFTER NC'屋'
           DISPLAY '<' WU '>'
           INSPECT WU CONVERTING NC'東大' TO NC'西小'
           DISPLAY '<' WU '>'
           INSPECT WU REPLACING ALL NC'＊' BY SPACE
           DISPLAY '<' WU '>'
           GOBACK.
])

AT_CHECK([$COMPILE -Wno-dialect -fdata-codeset=IBM-1399 prog.cob], [0], [], [])
AT_CHECK([COB_HOST_CODESET=UTF-8 $COBCRUN_DIRECT ./prog], [0],
[<東京、大阪ab   > 08
<東京 ><大阪 ><名古屋><、> 02 11 03
ALL: 02
CHARS BEFORE: 06
TRAILING: 01
<東京・大阪・名古屋 >
<東京・大阪・名古屋＊>
<西京・小阪・名古屋＊>
<西京・小阪・名古屋 >
], [])

AT_CLEANUP


