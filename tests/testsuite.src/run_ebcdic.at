### GnuCOBOL Test Suite

### data in EBCDIC (-fdata-codeset),
### see docs/proposal/ebcdic-internal-encoding-ja.md

AT_SETUP([EBCDIC data: invalid -fdata-codeset])
AT_KEYWORDS([ebcdic data-codeset])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       PROCEDURE        DIVISION.
           STOP RUN.
])

AT_CHECK([$COMPILE -fdata-codeset=IBM-4711 prog.cob], [1], [],
[cobc: error: invalid parameter: -fdata-codeset
])
AT_CHECK([$COMPILE -fdata-codeset=native prog.cob], [0], [], [])

AT_CLEANUP


AT_SETUP([EBCDIC data: literals and hexadecimal literals])
AT_KEYWORDS([ebcdic data-codeset literal])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  WK-CODE      PIC X(4)  VALUE 'AB12'.
       01  WK-HEX       PIC X(2)  VALUE X'C1F0'.
       01  WK-PAD       PIC X(4)  VALUE 'A'.
       01  WK-SPC       PIC X(2)  VALUE SPACES.
       01  WK-ZERO      PIC X(2)  VALUE ZERO.
       01  WK-QUOTE     PIC X(1)  VALUE QUOTE.
       PROCEDURE        DIVISION.
           DISPLAY FUNCTION HEX-OF (WK-CODE)
           DISPLAY FUNCTION HEX-OF (WK-HEX)
           DISPLAY FUNCTION HEX-OF (WK-PAD)
           DISPLAY FUNCTION HEX-OF (WK-SPC) FUNCTION HEX-OF (WK-ZERO)
                   FUNCTION HEX-OF (WK-QUOTE)
           IF WK-CODE (1:1) NOT = X'C1'
              DISPLAY 'A is not X"C1"'
           END-IF
           IF WK-HEX NOT = 'A0'
              DISPLAY 'X"C1F0" is not "A0"'
           END-IF
           MOVE 'XYZ' TO WK-PAD
           DISPLAY FUNCTION HEX-OF (WK-PAD)
           MOVE X'C2' TO WK-PAD
           DISPLAY FUNCTION HEX-OF (WK-PAD)
           MOVE ALL 'C' TO WK-PAD
           DISPLAY WK-PAD
           STOP RUN.
])

AT_CHECK([$COMPILE -fdata-codeset=IBM-1399 prog.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./prog], [0],
[C1C2F1F2
C1F0
C1404040
4040F0F07F
E7E8E940
C2404040
CCCC
], [])

AT_CLEANUP


AT_SETUP([EBCDIC data: zoned and packed decimal])
AT_KEYWORDS([ebcdic data-codeset sign])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  WK-AMT       PIC S9(3) VALUE -123.
       01  WK-POS       PIC S9(3) VALUE +45.
       01  WK-UNS       PIC 9(3)  VALUE 7.
       01  WK-SEP       PIC S9(3) SIGN LEADING SEPARATE VALUE -9.
       01  WK-PK        PIC S9(3) COMP-3.
       01  WK-ED        PIC -ZZ,ZZ9.99.
       PROCEDURE        DIVISION.
           DISPLAY FUNCTION HEX-OF (WK-AMT) ' '
                   FUNCTION HEX-OF (WK-POS) ' '
                   FUNCTION HEX-OF (WK-UNS) ' '
                   FUNCTION HEX-OF (WK-SEP)
           COMPUTE WK-AMT = WK-AMT * 2 + 7
           DISPLAY WK-AMT ' ' FUNCTION HEX-OF (WK-AMT)
           MOVE WK-AMT TO WK-PK
           DISPLAY FUNCTION HEX-OF (WK-PK)
           ADD 1 TO WK-UNS
           DISPLAY WK-UNS
           MOVE -1234.5 TO WK-ED
           DISPLAY '<' WK-ED '> ' FUNCTION HEX-OF (WK-ED)
           IF WK-POS IS NOT NUMERIC
              DISPLAY 'WK-POS is not numeric'
           END-IF
           DISPLAY FUNCTION NUMVAL ('  -12.5 ')
           STOP RUN.
])

AT_CHECK([$COMPILE -fdata-codeset=IBM-1399 prog.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./prog], [0],
[F1F2D3 F0F4C5 F0F0F7 60F0F0F9
-239 F2F3D9
239D
008
<- 1,234.50> 6040F16BF2F3F44BF5F0
-00000012.5
], [])

AT_CLEANUP


AT_SETUP([EBCDIC data: collating sequence])
AT_KEYWORDS([ebcdic data-codeset compare])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  WK-LOWER     PIC X VALUE 'a'.
       01  WK-UPPER     PIC X VALUE 'A'.
       01  WK-DIGIT     PIC X VALUE '9'.
       PROCEDURE        DIVISION.
           IF WK-LOWER < WK-UPPER
              DISPLAY 'a < A'
           END-IF
           IF WK-DIGIT > WK-UPPER
              DISPLAY '9 > A'
           END-IF
           IF 'a' < 'A'
              DISPLAY 'literal a < A'
           END-IF
           IF SPACE < 'A'
              DISPLAY 'SPACE < A'
           END-IF
           STOP RUN.
])

AT_CHECK([$COMPILE -fdata-codeset=IBM-037 prog.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./prog], [0],
[a < A
9 > A
literal a < A
SPACE < A
], [])

AT_CLEANUP


AT_SETUP([EBCDIC data: CCSID 930 lowercase letters])
AT_KEYWORDS([ebcdic data-codeset class])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       ENVIRONMENT      DIVISION.
       CONFIGURATION    SECTION.
       SPECIAL-NAMES.
           CLASS LOWER-AZ IS 'a' THRU 'z'.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  WK-LOW       PIC X(3) VALUE 'abz'.
       01  WK-UP        PIC X(3).
       PROCEDURE        DIVISION.
           DISPLAY FUNCTION HEX-OF (WK-LOW)
           MOVE FUNCTION UPPER-CASE (WK-LOW) TO WK-UP
           DISPLAY WK-UP ' ' FUNCTION HEX-OF (WK-UP)
           DISPLAY FUNCTION LOWER-CASE (WK-UP)
           IF WK-LOW IS ALPHABETIC-LOWER
              DISPLAY 'ALPHABETIC-LOWER'
           END-IF
           IF WK-LOW IS LOWER-AZ
              DISPLAY 'LOWER-AZ'
           END-IF
           IF WK-UP IS NOT LOWER-AZ
              DISPLAY 'NOT LOWER-AZ'
           END-IF
           STOP RUN.
])

AT_CHECK([$COMPILE -fdata-codeset=IBM-930 prog.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./prog], [0],
[6263B9
ABZ C1C2E9
abz
ALPHABETIC-LOWER
LOWER-AZ
NOT LOWER-AZ
], [])

AT_CHECK([$COMPILE -fdata-codeset=IBM-939 prog.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./prog], [0],
[8182A9
ABZ C1C2E9
abz
ALPHABETIC-LOWER
LOWER-AZ
NOT LOWER-AZ
], [])

AT_CLEANUP


AT_SETUP([EBCDIC data: ACCEPT and DISPLAY])
AT_KEYWORDS([ebcdic data-codeset])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  WK-IN        PIC X(5).
       01  WK-NUM       PIC 9(3).
       PROCEDURE        DIVISION.
           ACCEPT WK-IN
           DISPLAY WK-IN ' ' FUNCTION HEX-OF (WK-IN)
           ACCEPT WK-NUM
           ADD 1 TO WK-NUM
           DISPLAY WK-NUM
           STOP RUN.
])

AT_DATA([input.txt], [Hello
41
])

AT_CHECK([$COMPILE -fdata-codeset=IBM-1399 prog.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./prog < input.txt], [0],
[Hello C885939396
042
], [])

AT_CLEANUP


AT_SETUP([EBCDIC data: SEQUENTIAL and LINE SEQUENTIAL files])
AT_KEYWORDS([ebcdic data-codeset runfile])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       ENVIRONMENT      DIVISION.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
           SELECT SEQF ASSIGN TO 'seq.dat'
               ORGANIZATION IS SEQUENTIAL
               FILE STATUS IS WK-STATUS.
           SELECT LSF  ASSIGN TO 'ls.txt'
               ORGANIZATION IS LINE SEQUENTIAL.
       DATA             DIVISION.
       FILE             SECTION.
       FD  SEQF.
       01  SEQ-REC.
           05  S-CODE   PIC X(4).
           05  S-AMT    PIC S9(3).
           05  S-PK     PIC S9(3) COMP-3.
       FD  LSF.
       01  LS-REC       PIC X(20).
       WORKING-STORAGE  SECTION.
       01  WK-STATUS    PIC XX.
       01  WK-REC       PIC X(9).
       01  WK-IN        PIC X(20).
       PROCEDURE        DIVISION.
           OPEN OUTPUT SEQF LSF
           DISPLAY 'STATUS ' WK-STATUS ' ' FUNCTION HEX-OF (WK-STATUS)
           MOVE 'AB12' TO S-CODE
           MOVE -123   TO S-AMT
           MOVE -123   TO S-PK
           WRITE SEQ-REC
           MOVE 'Hello abz 123' TO LS-REC
           WRITE LS-REC
           CLOSE SEQF LSF
           OPEN INPUT SEQF LSF
           READ SEQF INTO WK-REC
           DISPLAY FUNCTION HEX-OF (WK-REC)
           READ LSF INTO WK-IN
           IF WK-IN NOT = 'Hello abz 123'
              DISPLAY 'LINE SEQUENTIAL: ' WK-IN
           END-IF
           READ SEQF
           DISPLAY 'STATUS ' WK-STATUS ' ' FUNCTION HEX-OF (WK-STATUS)
           CLOSE SEQF LSF
           STOP RUN.
])

AT_CHECK([$COMPILE -fdata-codeset=IBM-1399 prog.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./prog], [0],
[STATUS 00 F0F0
C1C2F1F2F1F2D3123D
STATUS 10 F1F0
], [])
AT_CHECK([cat ls.txt], [0],
[Hello abz 123
], [])

AT_CLEANUP


AT_SETUP([EBCDIC data: -std=ibm-jp and data-codeset])
AT_KEYWORDS([ebcdic data-codeset configuration])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  WK-LOW       PIC X(3) VALUE 'abz'.
       PROCEDURE        DIVISION.
           DISPLAY FUNCTION HEX-OF (WK-LOW)
           STOP RUN.
])

AT_DATA([test.conf], [
include "default.conf"
data-codeset: IBM-4711
])

AT_CHECK([$COMPILE -std=ibm-jp prog.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./prog], [0],
[8182A9
], [])

# the option overrides the configuration
AT_CHECK([$COMPILE -std=ibm-jp -fdata-codeset=IBM-930 prog.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./prog], [0],
[6263B9
], [])

AT_CHECK([$COMPILE -conf=test.conf prog.cob], [1], [],
[configuration error:
test.conf:3: invalid value 'IBM-4711' for configuration tag 'data-codeset';
	should be one of the following values: NATIVE, IBM-037, IBM-930, IBM-939, IBM-1390, IBM-1399
])

AT_CLEANUP


AT_SETUP([EBCDIC data: CODE-SET and ALPHABET])
AT_KEYWORDS([ebcdic data-codeset runfile sort])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       ENVIRONMENT      DIVISION.
       CONFIGURATION    SECTION.
       SPECIAL-NAMES.
           ALPHABET ASC IS STANDARD-1.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
           SELECT AF ASSIGN TO 'ascii.dat'
               ORGANIZATION IS SEQUENTIAL.
       DATA             DIVISION.
       FILE             SECTION.
       FD  AF CODE-SET IS ASC.
       01  A-REC        PIC X(4).
       WORKING-STORAGE  SECTION.
       01  T.
           05 TE        PIC X OCCURS 3.
       01  W            PIC X(4).
       PROCEDURE        DIVISION.
           OPEN OUTPUT AF
           MOVE 'Ab1 ' TO A-REC
           WRITE A-REC
           CLOSE AF
           OPEN INPUT AF
           READ AF INTO W
           CLOSE AF
           DISPLAY W FUNCTION HEX-OF (W)
           MOVE '1Aa' TO T
           SORT TE ASCENDING
           DISPLAY T
           SORT TE ASCENDING SEQUENCE ASC
           DISPLAY T
           SORT TE ASCENDING
           DISPLAY T
           IF 'a' < 'A'
              DISPLAY 'EBCDIC order'
           END-IF
           STOP RUN.
])

AT_CHECK([$COMPILE -Wno-unfinished -fdata-codeset=IBM-1399 prog.cob], [0], [], [])
AT_CHECK([$COBCRUN_DIRECT ./prog], [0],
[Ab1 C182F140
aA1
1Aa
aA1
EBCDIC order
], [])
AT_CHECK([cat ascii.dat], [0], [Ab1 ], [])

AT_CLEANUP


AT_SETUP([EBCDIC data: Japanese literals and DBCS])
AT_KEYWORDS([ebcdic data-codeset dbcs])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       ENVIRONMENT      DIVISION.
       INPUT-OUTPUT     SECTION.
       FILE-CONTROL.
           SELECT LSF  ASSIGN TO 'ls.txt'
               ORGANIZATION IS LINE SEQUENTIAL.
       DATA             DIVISION.
       FILE             SECTION.
       FD  LSF.
       01  LS-REC       PIC X(20).
       WORKING-STORAGE  SECTION.
       01  WK-MSG       PIC X(20) VALUE 'ｺﾝﾆﾁﾊ 漢字ABC'.
       01  WK-X         PIC X(10).
       01  WK-IN        PIC X(12).
       PROCEDURE        DIVISION.
           DISPLAY '<' WK-MSG '>'
           DISPLAY FUNCTION HEX-OF (WK-MSG)
           MOVE '日本語' TO WK-X
           DISPLAY '<' WK-X '> ' FUNCTION LENGTH ('日本語')
           DISPLAY 'メッセージ' & '!'
           ACCEPT WK-IN
           DISPLAY '<' WK-IN '> ' FUNCTION HEX-OF (WK-IN)
           OPEN OUTPUT LSF
           WRITE LS-REC FROM WK-MSG
           CLOSE LSF
           OPEN INPUT LSF
           READ LSF
           CLOSE LSF
           IF LS-REC NOT = WK-MSG
              DISPLAY 'LINE SEQUENTIAL: ' FUNCTION HEX-OF (LS-REC)
           END-IF
           STOP RUN.
])

AT_DATA([input.txt], [日本ｶﾅx
])

AT_CHECK([$COMPILE -fdata-codeset=IBM-1399 prog.cob], [0], [], [])
AT_CHECK([COB_HOST_CODESET=UTF-8 $COBCRUN_DIRECT ./prog < input.txt], [0],
[<ｺﾝﾆﾁﾊ 漢字ABC     >
70BC8D779B400E4F5848F20FC1C2C34040404040
<日本語  > 8
メッセージ!
<日本ｶﾅx   > 0E456245660F668CA7404040
], [])
AT_CHECK([cat ls.txt], [0],
[ｺﾝﾆﾁﾊ 漢字ABC
], [])

AT_CLEANUP


AT_SETUP([EBCDIC data: -fsource-codeset])
AT_KEYWORDS([ebcdic data-codeset dbcs])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       PROCEDURE        DIVISION.
           DISPLAY '漢字'
           STOP RUN.
])

AT_CHECK([$COMPILE -fdata-codeset=IBM-1399 -fsource-codeset=NOT-A-CODESET prog.cob], [1], [],
[prog.cob:5: error: cannot convert from 'NOT-A-CODESET' to 'IBM1399'
])
AT_CHECK([$COMPILE -fdata-codeset=IBM-1399 -fsource-codeset=ASCII prog.cob], [1], [],
[prog.cob:5: error: literal '漢字' cannot be converted to data codeset IBM-1399
])

AT_CLEANUP


AT_SETUP([EBCDIC data: DBCS items PIC G / PIC N])
AT_KEYWORDS([ebcdic data-codeset dbcs national])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  WK-G         PIC G(4) VALUE G'漢字'.
       01  WK-N         PIC N(3) USAGE DISPLAY-1 VALUE N'日本'.
       01  WK-S         PIC G(2) VALUE SPACES.
       01  WK-IN        PIC G(3).
       01  WK-REC.
           05 WK-A      PIC X(2) VALUE 'AB'.
           05 WK-B      PIC G(2) VALUE G'東京'.
       PROCEDURE        DIVISION.
           DISPLAY '<' WK-G '> ' FUNCTION HEX-OF (WK-G)
           DISPLAY '<' WK-N '> ' FUNCTION HEX-OF (WK-N)
           DISPLAY FUNCTION HEX-OF (WK-S) ' ' FUNCTION LENGTH (WK-G)
           MOVE WK-N TO WK-G
           DISPLAY '<' WK-G '> ' FUNCTION HEX-OF (WK-G)
           IF WK-G = N'日本'
              DISPLAY 'EQUAL'
           END-IF
           DISPLAY FUNCTION HEX-OF (WK-REC)
           ACCEPT WK-IN
           DISPLAY '<' WK-IN '> ' FUNCTION HEX-OF (WK-IN)
           STOP RUN.
])

AT_DATA([input.txt], [大阪 x
])

AT_CHECK([$COMPILE -fdata-codeset=IBM-1399 prog.cob], [0], [], [])
AT_CHECK([COB_HOST_CODESET=UTF-8 $COBCRUN_DIRECT ./prog < input.txt], [0],
[<漢字　　> 4F5848F240404040
<日本　> 456245664040
40404040 4
<日本　　> 4562456640404040
EQUAL
C1C245574575
<大阪　> 455B45914040
], [])

AT_DATA([prog2.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog2.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  WK-G         PIC G(2) VALUE G'漢a'.
       PROCEDURE        DIVISION.
           STOP RUN.
])

AT_CHECK([$COMPILE_ONLY -fdata-codeset=IBM-1399 prog2.cob], [1], [],
[prog2.cob:6: error: DBCS literal '漢a' contains single-byte characters
])

AT_CLEANUP


AT_SETUP([EBCDIC data: user-defined DBCS characters])
AT_KEYWORDS([ebcdic data-codeset dbcs gaiji])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  WK-GAIJI     PIC X(8) VALUE X'0E694169420F'.
       01  WK-IN        PIC X(8).
       PROCEDURE        DIVISION.
           DISPLAY '<' WK-GAIJI '>'
           ACCEPT WK-IN
           DISPLAY FUNCTION HEX-OF (WK-IN)
           STOP RUN.
])

AT_DATA([user.tbl], [# user-defined characters
6941 U+9AD9
6942 FA11
zzzz
])

AT_DATA([input.txt], [髙﨑
])

AT_CHECK([$COMPILE -fdata-codeset=IBM-1399 prog.cob], [0], [], [])
AT_CHECK([COB_DBCS_USER_TABLE=user.tbl COB_HOST_CODESET=UTF-8 $COBCRUN_DIRECT ./prog < input.txt], [0],
[<髙﨑  >
0E694169420F4040
],
[libcob: prog.cob:9: warning: invalid entry in COB_DBCS_USER_TABLE 'user.tbl', line 4
])

AT_CLEANUP


AT_SETUP([EBCDIC data: national items (UTF-16)])
AT_KEYWORDS([ebcdic data-codeset dbcs national nsymbol])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  WK-G         PIC G(2) VALUE G'漢字'.
       01  WK-N         PIC N(2) VALUE N'日本'.
       01  WK-U         PIC N(4) USAGE NATIONAL VALUE NC'東京ab'.
       01  WK-U2        PIC N(6) USAGE NATIONAL.
       01  WK-X         PIC X(10) VALUE 'ｶﾅ漢字'.
       01  WK-D         PIC N(3) USAGE DISPLAY-1.
       01  WK-IN        PIC N(4) USAGE NATIONAL.
       PROCEDURE        DIVISION.
           DISPLAY '<' WK-U '> ' FUNCTION HEX-OF (WK-U)
           DISPLAY FUNCTION HEX-OF (WK-N) ' ' FUNCTION LENGTH (WK-U)
           MOVE WK-X TO WK-U2
           DISPLAY '<' WK-U2 '> ' FUNCTION HEX-OF (WK-U2)
           MOVE WK-G TO WK-U2
           DISPLAY FUNCTION HEX-OF (WK-U2)
           MOVE WK-U TO WK-D
           DISPLAY '<' WK-D '> ' FUNCTION HEX-OF (WK-D)
           MOVE SPACE TO WK-U2
           DISPLAY FUNCTION HEX-OF (WK-U2)
           MOVE HIGH-VALUE TO WK-U2
           DISPLAY FUNCTION HEX-OF (WK-U2)
           MOVE N'あ' TO WK-U2
           DISPLAY FUNCTION HEX-OF (WK-U2)
           INITIALIZE WK-U2
           DISPLAY FUNCTION HEX-OF (WK-U2)
           ACCEPT WK-IN
           DISPLAY '<' WK-IN '> ' FUNCTION HEX-OF (WK-IN)
           STOP RUN.
])

AT_DATA([input.txt], [大阪x
])

AT_CHECK([$COMPILE -fdata-codeset=IBM-1399 prog.cob], [0], [],
[prog.cob:8: warning: national-character literal used
])
AT_CHECK([COB_HOST_CODESET=UTF-8 $COBCRUN_DIRECT ./prog < input.txt], [0],
[<東京ab> 67714EAC00610062
45624566 4
<ｶﾅ漢字  > FF76FF856F225B5700200020
6F225B570020002000200020
<東京　> 455745754040
002000200020002000200020
FFFFFFFFFFFFFFFFFFFFFFFF
304200200020002000200020
002000200020002000200020
<大阪x > 5927962A00780020
], [])

# with -fnsymbol=national PIC N and N literals are UTF-16
AT_CHECK([$COMPILE -fdata-codeset=IBM-1399 -fnsymbol=national -o prog2 prog.cob], [0], [],
[prog.cob:8: warning: national-character literal used
])
AT_CHECK([COB_HOST_CODESET=UTF-8 $COBCRUN_DIRECT ./prog2 < input.txt], [0],
[<東京ab> 67714EAC00610062
65E5672C 4
<ｶﾅ漢字  > FF76FF856F225B5700200020
6F225B570020002000200020
<東京　> 455745754040
002000200020002000200020
FFFFFFFFFFFFFFFFFFFFFFFF
304200200020002000200020
002000200020002000200020
<大阪x > 5927962A00780020
], [])

AT_CHECK([$COMPILE_ONLY -fdata-codeset=IBM-1399 -fnsymbol=utf8 prog.cob], [1], [],
[cobc: error: invalid parameter: -fnsymbol
])

AT_CLEANUP


AT_SETUP([EBCDIC data: NATIONAL-OF and DISPLAY-OF])
AT_KEYWORDS([ebcdic data-codeset dbcs national functions])

AT_DATA([prog.cob], [
       IDENTIFICATION   DIVISION.
       PROGRAM-ID.      prog.
       DATA             DIVISION.
       WORKING-STORAGE  SECTION.
       01  WK-X         PIC X(10) VALUE 'ｶﾅ漢字'.
       01  WK-G         PIC G(2) VALUE G'東京'.
       01  WK-U         PIC N(6) USAGE NATIONAL.
       01  WK-X2        PIC X(12).
       01  WK-UTF8      PIC X(12).
       PROCEDURE        DIVISION.
           MOVE FUNCTION NATIONAL-OF (WK-X) TO WK-U
           DISPLAY FUNCTION HEX-OF (WK-U)
           MOVE FUNCTION DISPLAY-OF (WK-U) TO WK-X2
           DISPLAY '<' WK-X2 '> ' FUNCTION HEX-OF (WK-X2)
           MOVE FUNCTION NATIONAL-OF (WK-G) TO WK-U
           DISPLAY '<' WK-U '> ' FUNCTION HEX-OF (WK-U)
           MOVE FUNCTION DISPLAY-OF (WK-U, 1208) TO WK-UTF8
           DISPLAY FUNCTION HEX-OF (WK-UTF8)
           MOVE FUNCTION NATIONAL-OF (WK-UTF8, 1208) TO WK-U
           DISPLAY FUNCTION HEX-OF (WK-U)
           DISPLAY FUNCTION LENGTH (FUNCTION NATIONAL-OF (WK-X))
           STOP RUN.
])

